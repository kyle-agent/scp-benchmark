# Copy to .env (gitignored) and fill in real values, then run ./run.sh
# .env is sourced by run.sh; never commit it.

S3_ENDPOINT=https://object-store.kr-west1.e.samsungsdscloud.com

# Two distinct accounts are required (ACL / cross-user tests need both).
S3_MAIN_ACCESS_KEY=
S3_MAIN_SECRET_KEY=
S3_ALT_ACCESS_KEY=
S3_ALT_SECRET_KEY=

# Optional. Region is used for SigV4 signing; some stores validate it.
S3_REGION=kr-west1
# path (recommended for S3-compatible stores) or virtual.
S3_ADDRESSING_STYLE=path
# {random} is padded by s3-tests to keep bucket names unique.
S3_BUCKET_PREFIX=s3compat-{random}-
