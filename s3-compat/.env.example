# Samsung Cloud Platform Object Storage - S3 compatibility test settings.
# Copy this file to ".env" and fill in your values. ".env" is gitignored.

# ── Endpoint ───────────────────────────────────────────────────────────────
# Full endpoint URL of the SCP object storage S3-compatible API.
# Example: https://object-store.kr-west1.e.samsungsdscloud.com
S3_ENDPOINT_URL=https://object-store.<region>.e.samsungsdscloud.com

# Region used only for SigV4 request signing. For most S3-compatible stores
# the exact value does not matter; "us-east-1" is a safe default.
S3_REGION=us-east-1

# Bucket addressing style: path | virtual | auto
# SCP object storage generally requires path-style addressing.
S3_ADDRESSING_STYLE=path

# Verify TLS certificates (true/false). Set false only for test endpoints.
S3_SSL_VERIFY=true

# ── Primary credentials (REQUIRED) ──────────────────────────────────────────
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Secondary user (OPTIONAL) ───────────────────────────────────────────────
# Distinct credentials for a SECOND user enable meaningful cross-user / ACL /
# tenant tests. If left blank, the primary credentials are reused so the suite
# can still run, but cross-user results should be treated as INDICATIVE ONLY.
S3_ALT_ACCESS_KEY=
S3_ALT_SECRET_KEY=
S3_TENANT_ACCESS_KEY=
S3_TENANT_SECRET_KEY=

# ── Test selection (OPTIONAL) ───────────────────────────────────────────────
# Space-separated test paths, relative to the s3-tests repo root. The default
# covers the core S3 API surface. Add more files to widen coverage, e.g.:
#   s3tests/functional/test_iam.py s3tests/functional/test_s3select.py
S3_TEST_PATHS="s3tests/functional/test_s3.py s3tests/functional/test_headers.py"

# pytest -m marker expression to filter tests, e.g. "not fails_on_aws".
# Leave blank to run everything in the selected paths.
S3_TEST_MARKERS=

# Extra args passed straight to pytest, e.g. "-k multipart" or "-x".
S3_PYTEST_EXTRA=
